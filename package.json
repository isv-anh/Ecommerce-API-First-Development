{
  "name": "e-commerce",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "ci": "pnpm install --frozen-lockfile",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",

    "generate:open-api": "pnpm --filter openapi-typespec generate",
    "api-client:dev": "pnpm --filter @e-commerce/api-client dev",
    "api-validation:dev": "pnpm --filter @e-commerce/api-validation dev"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.9.0",
      "date-fns": "^4.1.0",
      "zod": "^4.3.6"
    }
  }
}