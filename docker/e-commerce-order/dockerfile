# ============================================
# Stage 1: Build API application
# ============================================

ARG NODE_VERSION=22.17.0-slim

FROM node:${NODE_VERSION} AS builder

# Apply OS security patches
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# Copy root configs
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Cache bust for .npmignore
COPY packages/ ./packages/
COPY docs/ ./docs/

# Install project dependencies with frozen lockfile for reproducible builds
# Using cache mount for pnpm store to speed up installs
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

ENV NODE_ENV=production

# Generate types for API validation (required if used by e-commerce-order)
RUN pnpm run api-validation:build

# Generate Prisma Client for e-commerce-order
RUN pnpm --filter e-commerce-order exec prisma generate

# Build the package
RUN pnpm --filter e-commerce-order build

# Deploy isolated production environment
RUN pnpm --filter e-commerce-order --prod deploy --legacy /app/out

# Generate Prisma Client in the deployed environment
WORKDIR /app/out
RUN npx prisma generate

# ============================================
# Stage 2: Run API application
# ============================================

FROM node:${NODE_VERSION} AS runner

# Apply OS security patches
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Set production environment variables
ENV NODE_ENV=production
ENV PORT=50052
ENV HOSTNAME="0.0.0.0"

# Copy the deployed production environment from builder
COPY --from=builder --chown=node:node /app/out ./

# Switch to non-root user for security best practices
USER root
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
USER node

# Expose port 50052 for gRPC
EXPOSE 50052

# Start API server
CMD ["node", "dist/src/main"]
