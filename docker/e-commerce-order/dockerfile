# ============================================
# Stage 1: Build API application
# ============================================

ARG NODE_VERSION=22.17.0-slim

FROM node:${NODE_VERSION} AS builder

# Apply OS security patches
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# Copy root configs
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Cache bust for .npmignore
COPY packages/ ./packages/
COPY docs/ ./docs/

# Install project dependencies with frozen lockfile for reproducible builds
# Using cache mount for pnpm store to speed up installs
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

ENV NODE_ENV=production

# Generate types for API validation (required if used by e-commerce-order)
RUN pnpm run api-validation:build

# Generate Prisma Client for e-commerce-order
RUN pnpm --filter e-commerce-order exec prisma generate

# Build the package
RUN pnpm --filter e-commerce-order build

# Trace the compiled entrypoint and copy only files needed at runtime.
COPY docker/node-runtime/trace.mjs /app/trace-runtime.mjs
RUN node /app/trace-runtime.mjs packages/e-commerce-order/dist/main.js /app/runtime

# ============================================
# Stage 2: Minimal Node.js runtime
# ============================================
FROM gcr.io/distroless/nodejs22-debian13:nonroot AS runner

WORKDIR /app/packages/e-commerce-order
ENV NODE_ENV=production \
    PORT=50052 \
    HOSTNAME=0.0.0.0 \
    PATH=/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY --from=builder --chown=65532:65532 /app/runtime /app
COPY --from=builder --chown=65532:65532 /app/packages/proto /app/packages/proto

EXPOSE 50052
# The distroless entrypoint already invokes Node.js.
CMD ["dist/main.js"]
