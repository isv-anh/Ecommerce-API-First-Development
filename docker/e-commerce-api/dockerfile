# ============================================
# Stage 1: Build API application
# ============================================

ARG NODE_VERSION=22.17.0-slim

FROM node:${NODE_VERSION} AS builder

# Apply OS security patches
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends ca-certificates default-jdk-headless maven curl && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# Copy root configs
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Cache bust for .npmignore
COPY packages/ ./packages/
COPY docs/ ./docs/

# Install project dependencies with frozen lockfile for reproducible builds
# Using cache mount for pnpm store to speed up installs
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

ENV NODE_ENV=production

# Generate types for API validation
RUN pnpm run api-validation:build

# Generate build artifacts from source; no production credentials are needed.
RUN pnpm --filter proto generate
RUN DB_USERNAME=build DB_PASSWORD=build DB_HOST=localhost DB_PORT=5432 DB_NAME=build \
    pnpm --filter e-commerce-api exec prisma generate
RUN pnpm --filter e-commerce-api generate:controllers

# Bundle internal TypeScript aliases so plain Node can run the output.
RUN pnpm --filter e-commerce-api exec nest build --webpack --webpackPath webpack.config.js

# Trace the compiled entrypoint and copy only files needed at runtime.
COPY docker/node-runtime/trace.mjs /app/trace-runtime.mjs
RUN node /app/trace-runtime.mjs packages/e-commerce-api/dist/main.js /app/runtime

# ============================================
# Stage 2: Minimal Node.js runtime
# ============================================
FROM gcr.io/distroless/nodejs22-debian13:nonroot AS runner

WORKDIR /app/packages/e-commerce-api
ENV NODE_ENV=production \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    PATH=/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY --from=builder --chown=65532:65532 /app/runtime /app
COPY --from=builder --chown=65532:65532 /app/packages/proto /app/packages/proto

EXPOSE 8080 50051
# The distroless entrypoint already invokes Node.js.
CMD ["dist/main.js"]
