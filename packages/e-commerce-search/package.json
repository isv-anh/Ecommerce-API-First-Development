{
  "name": "e-commerce-search",
  "version": "1.0.0",
  "description": "e-commerce search engine",
  "scripts": {
    "proto:generate": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=outputServices=grpc-js,env=node,esModuleInterop=true -I=./proto ./proto/*.proto",
    "build": "pnpm run proto:generate && tsc",
    "server": "ts-node src/server.ts",
    "client": "ts-node src/client.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@elastic/elasticsearch": "^9.5.1",
    "@grpc/grpc-js": "^1.14.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.12.1",
    "typescript": "catalog:"
  }
}
