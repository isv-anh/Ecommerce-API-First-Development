{
  "name": "@e-commerce/api-client",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./schemas/*": {
      "import": "./dist/esm/generated/schemas/*/index.js",
      "types": "./dist/tsc/generated/schemas/*/index.d.ts"
    },
    "./endpoints/*": {
      "import": "./dist/esm/generated/endpoints/*.js",
      "types": "./dist/tsc/generated/endpoints/*.d.ts"
    },
    "./mutator/*": {
      "import": "./dist/esm/mutator/*.js",
      "types": "./dist/tsc/mutator/*.d.ts"
    },
    "./storages/*": {
      "import": "./dist/esm/storages/*.js",
      "types": "./dist/tsc/storages/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "generate": "orval --config ./orval.config.ts",
    "build": "pnpm generate &&node build.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:",
    "next": "^16.1.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^20.19.43",
    "axios": "^1.18.1",
    "esbuild": "^0.27.7",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "msw": "^2.15.0",
    "orval": "^7.21.0",
    "prettier": "3.5.3",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
