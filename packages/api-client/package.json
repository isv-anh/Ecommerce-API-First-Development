{
  "name": "@e-commerce/api-client",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./schemas/*": {
      "import": "./dist/esm/generated/schemas/*/index.js",
      "types": "./dist/types/generated/schemas/*/index.d.ts"
    },
    "./endpoints/petstore/*": {
      "import": "./dist/esm/generated/endpoints/petstore/*.js",
      "types": "./dist/types/generated/endpoints/petstore/*.d.ts"
    },
    "./endpoints/system/*": {
      "import": "./dist/esm/generated/endpoints/system/*.js",
      "types": "./dist/types/generated/endpoints/system/*.d.ts"
    },
    "./zod/*": {
      "import": "./dist/esm/generated/zod/*.js",
      "types": "./dist/types/generated/zod/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "generate": "orval --config ./orval.config.ts",
    "build": "node build.mjs",
    "dev": "pnpm generate && pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@types/node": "^20.19.37",
    "axios": "catalog:",
    "esbuild": "^0.27.4",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "msw": "^2.10.4",
    "orval": "^7.9.0",
    "prettier": "3.5.3",
    "typescript": "^5",
    "zod": "catalog:"
  }
}
